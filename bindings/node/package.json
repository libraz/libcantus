{
  "name": "@libraz/libcantus-node",
  "version": "1.3.0",
  "private": true,
  "description": "libcantus over its native C++ core: a Node-API addon behind the TS facade.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./theory": {
      "import": {
        "types": "./dist/theory/index.d.ts",
        "default": "./dist/theory/index.js"
      },
      "require": {
        "types": "./dist/theory/index.d.cts",
        "default": "./dist/theory/index.cjs"
      }
    },
    "./analyze": {
      "import": {
        "types": "./dist/analyze/index.d.ts",
        "default": "./dist/analyze/index.js"
      },
      "require": {
        "types": "./dist/analyze/index.d.cts",
        "default": "./dist/analyze/index.cjs"
      }
    },
    "./generate": {
      "import": {
        "types": "./dist/generate/index.d.ts",
        "default": "./dist/generate/index.js"
      },
      "require": {
        "types": "./dist/generate/index.d.cts",
        "default": "./dist/generate/index.cjs"
      }
    },
    "./model": {
      "import": {
        "types": "./dist/model/index.d.ts",
        "default": "./dist/model/index.js"
      },
      "require": {
        "types": "./dist/model/index.d.cts",
        "default": "./dist/model/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "theory": [
        "./dist/theory/index.d.ts"
      ],
      "analyze": [
        "./dist/analyze/index.d.ts"
      ],
      "generate": [
        "./dist/generate/index.d.ts"
      ],
      "model": [
        "./dist/model/index.d.ts"
      ]
    }
  },
  "binary": {
    "napi_versions": [
      8
    ]
  }
}
