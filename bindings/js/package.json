{
  "name": "@libraz/libcantus-facade",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "TS facade over the libcantus op boundary; bundled by the wasm and node packages.",
  "imports": {
    "#backend": "./src/backends/ts.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./theory": "./src/theory.ts",
    "./analyze": "./src/analyze.ts",
    "./generate": "./src/generate.ts",
    "./model": "./src/model.ts",
    "./runtime": "./src/runtime.ts",
    "./backend": "./src/backend.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
