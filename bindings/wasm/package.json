{
  "name": "@libraz/libcantus-wasm",
  "version": "1.3.0",
  "private": true,
  "description": "libcantus music theory engine compiled to WebAssembly, behind the same API and types as @libraz/libcantus. ESM only; instantiates with top-level await.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "libraz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/libcantus.git",
    "directory": "bindings/wasm"
  },
  "homepage": "https://github.com/libraz/libcantus#readme",
  "bugs": {
    "url": "https://github.com/libraz/libcantus/issues"
  },
  "keywords": [
    "music-theory",
    "music",
    "chords",
    "scales",
    "intervals",
    "harmony",
    "composition",
    "midi",
    "chord-detection",
    "voicing",
    "reharmonization",
    "arrangement",
    "generative-music",
    "webassembly",
    "wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./theory": {
      "types": "./dist/theory/index.d.ts",
      "default": "./dist/theory/index.js"
    },
    "./analyze": {
      "types": "./dist/analyze/index.d.ts",
      "default": "./dist/analyze/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "theory": [
        "./dist/theory/index.d.ts"
      ],
      "analyze": [
        "./dist/analyze/index.d.ts"
      ],
      "generate": [
        "./dist/generate/index.d.ts"
      ],
      "model": [
        "./dist/model/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "make -C ../.. wasm",
    "typecheck": "tsc -p tsconfig.json"
  }
}
