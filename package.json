{
  "name": "libcantus-workspace",
  "private": true,
  "version": "1.3.0",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "ts",
    "bindings/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "spec": "nice -n 10 vitest run -c tests/spec/vitest.config.ts --maxWorkers=2",
    "spec:ready": "make spec-ready",
    "corpus": "CANTUS_IMPL=facade-ts CANTUS_RECORD=1 nice -n 10 vitest run -c tests/spec/vitest.config.ts --maxWorkers=2 && node tools/corpus/merge.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "cmake-js": "^8.0.0",
    "esbuild": "0.27.7",
    "node-addon-api": "^8.9.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
