# Dependencies and the package manager's state.
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build trees and package output: build/, build-release/, build-wasm/, build-shared/,
# build-install/ and the node addon's bindings/node/build/; ts/dist/ and bindings/*/dist/.
build*/
dist/
compile_commands.json

# Generated docs, test output and the recorded call corpus.
docs/api/
ts/docs/api/
coverage/
ts/test/generated/
tests/spec/generated/
tests/corpus/out/

# Tool caches and the Python environment.
.cache/
.ruff_cache/
__pycache__/
bindings/python/.venv/

# Local notes and agent configuration.
backup/
.claude/
.serena/
AGENT.md
CLAUDE.md
.DS_Store
*.log
